+function generateAnalysis(m){
+  const Y=m.years, f5=Y.slice(0,5), N=v=>fmt(v)+' '+S.meta.currency;
+  const firstProfit=Y.findIndex(y=>y.net>0)+1;
+  const lossYears=f5.filter(y=>y.net<0).map(y=>y.y);
+  const cumNet5=f5.reduce((a,y)=>a+y.net,0);
+  const minNet=Math.min(...f5.map(y=>y.net));
+  let income;
+  if(lossYears.length===0){
+    income='Sur les 5 premiers exercices, l activite degage un <b>resultat net positif des l An '+firstProfit+'</b> ('+N(Y[firstProfit-1].net)+'). Aucune annee n est deficitaire. Le resultat net cumule atteint <b>'+N(cumNet5)+'</b>. <span class="verdict ok">L activite est rentable des le demarrage.</span>';
+  } else {
+    income='Des pertes apparaissent en An '+lossYears.join(', ')+' (minimum '+N(minNet)+'), du fait des amortissements et charges fixes. Seuil de rentabilite franchi en <b>An '+(firstProfit>0?firstProfit:'--')+'</b>. Resultat net cumule sur 5 ans : <b>'+N(cumNet5)+'</b>. '+(cumNet5>0?'<span class="verdict ok">Rentable sur la periode.</span>':'<span class="verdict warn">Attention : cumul negatif sur 5 ans.</span>');
+  }
+  const minCash=Math.min(...f5.map(y=>y.cash)); const minCashY=f5.find(y=>y.cash===minCash).y;
+  const negCashY=f5.filter(y=>y.cash<0).map(y=>y.y);
+  let cashflow;
+  if(negCashY.length===0){
+    cashflow='La tresorerie reste <b>positive</b> pendant les 5 exercices (point bas : '+N(minCash)+' en An '+minCashY+'). Les flux d exploitation couvrent largement les besoins. <span class="verdict ok">Aucun besoin de financement complementaire.</span>';
+  } else {
+    cashflow='<span class="verdict warn">Attention : tresorerie negative en An '+negCashY.join(', ')+' (point bas '+N(minCash)+'). Renforcer le fonds de roulement ou le capital.</span>';
+  }
+  const a1=Y[0], a5=f5[4];
+  const ta1=a1.cash+a1.ar+a1.inv+a1.ppe, ta5=a5.cash+a5.ar+a5.inv+a5.ppe;
+  const eq1=a1.capital+a1.retained, eq5=a5.capital+a5.retained;
+  const balance='Le total du bilan passe de <b>'+N(ta1)+'</b> (An 1) a <b>'+N(ta5)+'</b> (An 5). Les reserves cumulees atteignent <b>'+N(a5.retained)+'</b>. '+(a5.loanBal>0?'Emprunt residuel : '+N(a5.loanBal)+'. ':'Aucun emprunt residuel. ')+'Les capitaux propres passent de '+N(eq1)+' a <b>'+N(eq5)+'</b> : la structure financiere se renforce.';
+  return {income,cashflow,balance};
+}
+function analysisBlock(title,html){ return '<div class="analysis"><div class="analysis-h">'+title+'</div><div class="analysis-b">'+html+'</div></div>'; }
+function renderInvest(m){
+  const n=S.meta.nAssociates, contrib=S.meta.capitalPerAssociate, payout=S.finance.dividendPayout/100, Y=m.years;
+  let rows='', cum=0, payback='--';
+  Y.forEach(y=>{
+    const totDiv=y.net>0?y.net*payout:0, per=totDiv/n;
+    cum+=per;
+    if(per>0 && cum>=contrib && payback==='--') payback='An '+y.y;
+    rows+='<tr><td class="lbl">An '+y.y+'</td><td>'+fmt(y.net)+'</td><td>'+fmt(totDiv)+'</td><td>'+fmt(per)+'</td><td>'+fmt(cum)+'</td><td>'+(cum/contrib*100).toFixed(0)+' %</td></tr>';
+  });
+  const totalDivPer=Y.reduce((a,y)=>a+(y.net>0?y.net*payout/n:0),0);
+  const roi=totalDivPer/contrib*100;
+  const kpi=[['Apport par associe',fmt(contrib)],['Part de capital',(100/n).toFixed(1)+' %'],['Dividendes cumules / associe (10 ans)',fmt(totalDivPer)],['ROI sur 10 ans',roi.toFixed(0)+' %'],['Seuil de remboursement',payback]];
+  F('investWrap').innerHTML='<h2>Appel a investissement</h2><div class="sub">Rendement estime pour chacun des '+n+' associes (distribution de '+S.finance.dividendPayout+' % du resultat net).</div><div class="kpirow">'+kpi.map(x=>'<div class="kpi"><div class="l">'+x[0]+'</div><div class="v">'+x[1]+'</div></div>').join('')+'</div><div style="overflow-x:auto"><table class="fin"><thead><tr><th>Exercice</th><th>Resultat net</th><th>Dividendes totaux</th><th>Dividende / associe</th><th>Cumul / associe</th><th>ROI cumule</th></tr></thead><tbody>'+rows+'</tbody></table></div>'+analysisBlock('Pourquoi adherer ?','Avec un apport de <b>'+fmt(contrib)+' '+S.meta.currency+'</b>, chaque associe recupere sa mise en <b>'+payback+'</b> et percoit <b>'+fmt(totalDivPer)+' '+S.meta.currency+'</b> de dividendes cumules sur 10 ans (ROI <b>'+roi.toFixed(0)+' %</b>), sans compter la plus-value de sa part. De plus, <b>AMZ fournit les equipements a 50 %</b>, reduisant fortement l investissement initial.');
+}
